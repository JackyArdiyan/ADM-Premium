{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "default",
  "description": "Izin default untuk window utama ADM Premium Desktop",
  "windows": ["main"],
  "remote": {
    "urls": [
      "https://liesspd.blogspot.com/*",
      "https://*.blogspot.com/*"
    ]
  },
  "permissions": [
    "core:default",
    "dialog:default",
    "fs:default",
    {
      "identifier": "fs:allow-write-file",
      "allow": [{ "path": "**" }]
    }
  ]
}
